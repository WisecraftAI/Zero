# OPTIONAL single-container demo image (`zero-demo`) — not the production path.
#
# Production and Compose keep the API, orchestrator, and executor in three
# separate images and hand work between them over Redis (`REDIS_URL`). This
# image co-locates all three in ONE process via scripts/local-stack.js, which
# is the only way `ZERO_CLOUD=local` works without Redis: the local queue in
# packages/cloud/local/queue.js is in-process, so a publisher and a subscriber
# in different containers never see each other.
#
# Result: one scale-to-zero container runs a full demo with no Redis, no
# Postgres (memory + file persistence), and no object-store bill.
#
#   docker build -f Dockerfile.demo -t zero-demo .
#   docker run --rm -p 3001:3001 -e KEY_ENC_SECRET=$(openssl rand -hex 32) zero-demo
#
# NODE_ENV is deliberately left unset. Setting NODE_ENV=production forces
# verified auth on /runs, and the SPA does not send x-api-key — the UI would
# get 401 on every call. See support/zero-docs/docs/v1/DEPLOY.md.
FROM mcr.microsoft.com/playwright:v1.58.2-jammy

ENV PORT=3001 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    ZERO_CLOUD=local \
    EXECUTION_MODE=minimal

WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts/local-stack.js ./scripts/local-stack.js
COPY services/api ./services/api
COPY services/orchestrator ./services/orchestrator
COPY services/executor ./services/executor
COPY packages/analyzer ./packages/analyzer
COPY packages/builders ./packages/builders
COPY packages/cloud ./packages/cloud
COPY packages/db ./packages/db
COPY packages/domain ./packages/domain
COPY packages/locators ./packages/locators
RUN npm ci --omit=dev \
      --workspace @zero/api \
      --workspace @zero/orchestrator \
      --workspace @zero/executor \
      --include-workspace-root

RUN mkdir -p /app/dist/artifacts /app/dist/logs \
  && chown -R pwuser:pwuser /app/dist

USER pwuser

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "scripts/local-stack.js"]
