{
  "name": "zero",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise QA Orchestration Platform - Automated Testing with AI Agents",
  "workspaces": [
    "services/*",
    "packages/*",
    "web"
  ],
  "scripts": {
    "start": "node services/api/server.js",
    "start:all": "node scripts/local-stack.js",
    "orchestrator": "node services/orchestrator/worker.js",
    "execution": "node services/executor/main.js",
    "dev": "nodemon services/api/server.js",
    "build": "npm run build -w @zero/web",
    "client": "npm run dev -w @zero/web",
    "set-db": "node scripts/set-database.js",
    "brand:generate": "node scripts/generate-brand-assets.js",
    "docs": "node support/zero-docs/scripts/generate-lld.mjs",
    "docs:api": "jsdoc -c jsdoc.config.json",
    "docs:build": "npm run docs:api && npm --prefix support/zero-docs run build",
    "analyser-doc": "node support/zero-docs/scripts/generate-analyzer-doc.mjs",
    "packages-doc": "node support/zero-docs/scripts/generate-packages-doc.mjs",
    "taxonomy-doc": "node support/zero-docs/scripts/generate-domain-test-plans.mjs",
    "docs:dev": "npm run docs:api && npm --prefix support/zero-docs run dev",
    "workflow:status": "node support/agent-workflow/scripts/detect-milestone.js",
    "workflow:verify": "node support/agent-workflow/scripts/verify-milestone.js",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:smoke": "jest --coverage=false test/smoke.test.js",
    "test:ci": "jest --coverage=false --runInBand",
    "test:web": "npm test -w @zero/web",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "qa",
    "playwright",
    "orchestration",
    "ai",
    "automation",
    "testing",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.5",
    "nodemon": "^3.1.7"
  }
}
