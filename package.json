{
  "name": "zero",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise QA Orchestration Platform - Automated Testing with AI Agents",
  "workspaces": [
    "apps/*",
    "packages/*",
    "web"
  ],
  "scripts": {
    "start": "node apps/api/server.js",
    "start:all": "node scripts/local-stack.js",
    "orchestrator": "node apps/orchestrator/worker.js",
    "execution": "node apps/executor/main.js",
    "dev": "nodemon apps/api/server.js",
    "build": "npm run build -w @zero/web",
    "production:build": "npm run build && npx playwright install chromium",
    "client": "npm run dev -w @zero/web",
    "set-db": "node scripts/set-database.js",
    "workflow:status": "node agent-workflow/scripts/detect-milestone.js",
    "workflow:verify": "node agent-workflow/scripts/verify-milestone.js",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:smoke": "jest --coverage=false test/smoke.test.js",
    "test:ci": "jest --coverage=false --runInBand"
  },
  "keywords": [
    "qa",
    "playwright",
    "orchestration",
    "ai",
    "automation",
    "testing",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7"
  }
}
