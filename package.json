{
  "name": "ai-qa-orchestrator",
  "version": "2.0.0",
  "description": "Enterprise QA Orchestration Platform - Automated Testing with AI Agents",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "orchestrator": "ORCHESTRATOR_ONLY=1 node workers/orchestrator.js",
    "execution": "EXECUTION_WORKER_ONLY=1 node workers/execution.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm install && npm run build",
    "production:build": "npm run build && npx playwright install chromium",
    "client": "cd client && npm run dev",
    "set-db": "node scripts/set-database.js",
    "workflow:status": "node agent-workflow/scripts/detect-milestone.js",
    "workflow:verify": "node agent-workflow/scripts/verify-milestone.js",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:smoke": "jest test/smoke.test.js --coverage=false",
    "test:ci": "jest --coverage=false --runInBand"
  },
  "keywords": [
    "qa",
    "playwright",
    "orchestration",
    "ai",
    "automation",
    "testing",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1",
    "playwright": "^1.52.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7"
  }
}
