# Copy this file to .env and set values. All are optional.
# Leave DATABASE_URL empty to run in memory-only mode (no Postgres).

# Server port (default 3000; app will try 3001, 3002... if busy)
PORT=3000

# Postgres: use one of the two options below.

# Option 1: single connection string (replace with your real password and DB name)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/qa_orchestrator

# Option 2: separate variables (uncomment and set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=qa_orchestrator
# PGSSL=false
