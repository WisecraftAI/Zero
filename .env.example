# Copy this file to .env and set values. All are optional.
# Leave DATABASE_URL empty to run in memory-only mode (no Postgres).
#
# Local Docker stack (V3 S7): docker compose up --build
#   Web UI  http://localhost:3000
#   API     http://localhost:3001/health
# Hybrid:   docker compose up -d postgres redis  →  npm run start:all on host
# Optional: docker compose --profile s3 up -d minio minio-init  (S3 drill only)
# If host ports are busy: WEB_PORT=3080 API_PORT=3081 POSTGRES_PORT=15432 REDIS_PORT=16379 docker compose up --build


# API server port (default 3001 since S7; nginx serves the SPA on :3000)
PORT=3001

# Cloud adapter selector. local (default) | aws | gcp | azure | vercel
ZERO_CLOUD=local
# Signed URLs point at the API service origin, not the SPA origin.
ZERO_PUBLIC_BASE_URL=http://localhost:3001
# HMAC key for /cloud/local signed URLs (ZERO_CLOUD=local). Defaults to a dev
# value. Must be IDENTICAL in every process that signs or verifies, so set it
# explicitly whenever API / orchestrator / executor are separate containers.
# ZERO_LOCAL_STORE_SECRET=replace-with-a-long-random-string
# Override where the local object store writes (default dist/artifacts/cloud-store)
# ZERO_LOCAL_STORE_DIR=
# Baked into the Vite bundle at build time — where the SPA fetches the API.
# VITE_API_BASE_URL=http://localhost:3001
# SEO, also build-time only (shell env, web/.env, or the web image build arg).
# Set the public origin once you own a domain; canonical / og:url / og:image
# and sitemap.xml stay out of the HTML until then. A bare host is fine.
# VITE_PUBLIC_SITE_URL=https://zer0.io
# Default is noindex,nofollow — ZER0 is an operator console, not a public page.
# Flip to true only for a deployment you actually want in search results.
# VITE_SEO_INDEX=false
# AWS: ZERO_S3_BUCKET, ZERO_SQS_RUNS_REQUESTED, ZERO_SQS_EXECUTION_REQUESTED, ZERO_SQS_EXECUTION_COMPLETED
# GCP: ZERO_GCS_BUCKET, GOOGLE_CLOUD_PROJECT

# Production deployment
# On Railway, do not set PORT manually; Railway injects it.
NODE_ENV=production
RAILWAY_PUBLIC_DOMAIN=zero-production-ee8c.up.railway.app
PUBLIC_URL=https://zero-production-ee8c.up.railway.app
FRONTEND_URL=https://zero-production-ee8c.up.railway.app
CLIENT_URL=https://zero-production-ee8c.up.railway.app
ALLOWED_ORIGINS=https://zero-production-ee8c.up.railway.app

# Postgres: use one of the two options below.
# Compose default (matches docker-compose.yml):
# DATABASE_URL=postgres://zero:zero@localhost:5432/zero
# If host 5432 is taken: POSTGRES_PORT=15432 docker compose up -d postgres
# DATABASE_URL=postgres://zero:zero@localhost:15432/zero

# Option 1: single connection string (replace with your real password and DB name)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/qa_orchestrator

# Option 2: separate variables (uncomment and set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=qa_orchestrator
# PGSSL=false

# Redis (compose service; wired in M3 for queue / SSE pub-sub)
# REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object store (compose service; wired in M2)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=zero-artifacts
# S3_ACCESS_KEY=zerominio
# S3_SECRET_KEY=zerominio123

# Execution (default minimal — reliable pipeline; full is opt-in/brittle)
# EXECUTION_MODE=minimal
# ZERO_DISCOVERED_FLOW_LIMIT=20 # URL-analysis execution case cap
# ZERO_LOCATOR_HEALING=on       # accessible-intent fallback; learned selectors are host-scoped
# ZERO_ANALYZER_MAX_PAGES=8   # Web Analyzer multi-page crawl cap (Q1)

# Auth (M5). Production always requires a verified key/JWT and KEY_ENC_SECRET.
# Local UI stays open unless ZERO_AUTH=on.
# ZERO_AUTH=on
# ZERO_API_KEYS=acme:qa@acme.test:replace-me,beta:qa@beta.test:replace-me-too
# ZERO_DEV_API_KEY=local-dev-key
# ZERO_AUTH_JWT_SECRET=
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_PUBLIC_KEY=
# KEY_ENC_SECRET=replace-with-a-long-random-string
# RECORDING_ORIGINS=https://www.example-ott.com

# LLM (M6). Pipeline uses stored /provider-keys or .env when ZERO_LLM_ENV_KEYS=1.
# Default: no keys → templates only ($0). Best free cloud option: Gemini (Google AI Studio).
# ZERO_LLM=off          # force templates even if keys exist
# ZERO_LLM_ENV_KEYS=1   # read OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY from env
# ZERO_LLM_RPM=20
# ZERO_LLM_MAX_USD_PER_RUN=0.50
# ZERO_LLM_TIMEOUT_MS=8000
# GEMINI_API_KEY=       # free tier: https://aistudio.google.com/app/apikey
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
