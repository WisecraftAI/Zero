{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_comment": "Starter design tokens following W3C Design Tokens Community Group format. Three-tier architecture: primitives (raw values), semantic (intent-based aliases), component (component-specific). Extend and override as needed.",

  "primitive": {
    "color": {
      "gray": {
        "50":  { "$value": "#FAFAFA", "$type": "color" },
        "100": { "$value": "#F5F5F6", "$type": "color" },
        "200": { "$value": "#E7E7EA", "$type": "color" },
        "300": { "$value": "#D1D1D6", "$type": "color" },
        "400": { "$value": "#A1A1AA", "$type": "color" },
        "500": { "$value": "#71717A", "$type": "color" },
        "600": { "$value": "#52525B", "$type": "color" },
        "700": { "$value": "#3F3F46", "$type": "color" },
        "800": { "$value": "#27272A", "$type": "color" },
        "900": { "$value": "#18181B", "$type": "color" },
        "950": { "$value": "#0B0B0D", "$type": "color" }
      },
      "blue": {
        "50":  { "$value": "#EFF5FF", "$type": "color" },
        "100": { "$value": "#DBE8FE", "$type": "color" },
        "200": { "$value": "#BEDAFF", "$type": "color" },
        "300": { "$value": "#91C0FF", "$type": "color" },
        "400": { "$value": "#5B9CF7", "$type": "color" },
        "500": { "$value": "#2B5DFA", "$type": "color" },
        "600": { "$value": "#2143D6", "$type": "color" },
        "700": { "$value": "#1A34A8", "$type": "color" },
        "800": { "$value": "#182B85", "$type": "color" },
        "900": { "$value": "#172566", "$type": "color" },
        "950": { "$value": "#0E1740", "$type": "color" }
      },
      "green": {
        "50":  { "$value": "#F0FDF4", "$type": "color" },
        "500": { "$value": "#16A34A", "$type": "color" },
        "700": { "$value": "#15803D", "$type": "color" }
      },
      "amber": {
        "50":  { "$value": "#FFFBEB", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      },
      "red": {
        "50":  { "$value": "#FEF2F2", "$type": "color" },
        "500": { "$value": "#DC2626", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    },
    "space": {
      "0":  { "$value": "0px",  "$type": "dimension" },
      "1":  { "$value": "2px",  "$type": "dimension" },
      "2":  { "$value": "4px",  "$type": "dimension" },
      "3":  { "$value": "8px",  "$type": "dimension" },
      "4":  { "$value": "12px", "$type": "dimension" },
      "5":  { "$value": "16px", "$type": "dimension" },
      "6":  { "$value": "20px", "$type": "dimension" },
      "7":  { "$value": "24px", "$type": "dimension" },
      "8":  { "$value": "32px", "$type": "dimension" },
      "9":  { "$value": "40px", "$type": "dimension" },
      "10": { "$value": "48px", "$type": "dimension" },
      "11": { "$value": "64px", "$type": "dimension" },
      "12": { "$value": "80px", "$type": "dimension" },
      "13": { "$value": "96px", "$type": "dimension" },
      "14": { "$value": "128px", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0px", "$type": "dimension" },
      "sm":   { "$value": "4px", "$type": "dimension" },
      "md":   { "$value": "8px", "$type": "dimension" },
      "lg":   { "$value": "12px", "$type": "dimension" },
      "xl":   { "$value": "16px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "borderWidth": {
      "0":    { "$value": "0px", "$type": "dimension" },
      "thin": { "$value": "1px", "$type": "dimension" },
      "thick":{ "$value": "2px", "$type": "dimension" }
    },
    "font": {
      "family": {
        "sans": { "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
        "mono": { "$value": "'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily" }
      },
      "weight": {
        "regular":  { "$value": 400, "$type": "fontWeight" },
        "medium":   { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold":     { "$value": 700, "$type": "fontWeight" }
      },
      "size": {
        "100": { "$value": "12px", "$type": "dimension" },
        "200": { "$value": "13px", "$type": "dimension" },
        "300": { "$value": "14px", "$type": "dimension" },
        "400": { "$value": "16px", "$type": "dimension" },
        "500": { "$value": "20px", "$type": "dimension" },
        "600": { "$value": "24px", "$type": "dimension" },
        "700": { "$value": "30px", "$type": "dimension" },
        "800": { "$value": "38px", "$type": "dimension" },
        "900": { "$value": "48px", "$type": "dimension" },
        "1000":{ "$value": "60px", "$type": "dimension" }
      },
      "lineHeight": {
        "tight":   { "$value": 1.2,  "$type": "number" },
        "snug":    { "$value": 1.35, "$type": "number" },
        "normal":  { "$value": 1.5,  "$type": "number" },
        "relaxed": { "$value": 1.625,"$type": "number" }
      },
      "tracking": {
        "tight":  { "$value": "-0.01em", "$type": "dimension" },
        "normal": { "$value": "0em", "$type": "dimension" },
        "wide":   { "$value": "0.04em", "$type": "dimension" },
        "wider":  { "$value": "0.08em", "$type": "dimension" }
      }
    },
    "elevation": {
      "0": { "$value": "none", "$type": "shadow" },
      "1": { "$value": "0 1px 2px 0 rgba(0,0,0,0.05)", "$type": "shadow" },
      "2": { "$value": "0 2px 4px -1px rgba(0,0,0,0.06), 0 1px 2px 0 rgba(0,0,0,0.04)", "$type": "shadow" },
      "3": { "$value": "0 6px 16px -4px rgba(0,0,0,0.10), 0 2px 6px -2px rgba(0,0,0,0.05)", "$type": "shadow" },
      "4": { "$value": "0 16px 40px -8px rgba(0,0,0,0.14)", "$type": "shadow" },
      "5": { "$value": "0 24px 60px -12px rgba(0,0,0,0.20)", "$type": "shadow" }
    },
    "motion": {
      "duration": {
        "instant":  { "$value": "0ms",   "$type": "duration" },
        "fast":     { "$value": "150ms", "$type": "duration" },
        "standard": { "$value": "250ms", "$type": "duration" },
        "slow":     { "$value": "400ms", "$type": "duration" }
      },
      "ease": {
        "linear":   { "$value": "linear", "$type": "cubicBezier" },
        "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
        "in":       { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" },
        "out":      { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier" },
        "emphasized":{ "$value": "cubic-bezier(0.2, 0, 0, 1.4)", "$type": "cubicBezier" }
      }
    },
    "zIndex": {
      "base":    { "$value": 0,    "$type": "number" },
      "raised":  { "$value": 10,   "$type": "number" },
      "dropdown":{ "$value": 100,  "$type": "number" },
      "sticky":  { "$value": 500,  "$type": "number" },
      "overlay": { "$value": 1000, "$type": "number" },
      "modal":   { "$value": 1100, "$type": "number" },
      "toast":   { "$value": 1200, "$type": "number" },
      "tooltip": { "$value": 1300, "$type": "number" }
    },
    "breakpoint": {
      "sm": { "$value": "480px",  "$type": "dimension" },
      "md": { "$value": "768px",  "$type": "dimension" },
      "lg": { "$value": "1024px", "$type": "dimension" },
      "xl": { "$value": "1280px", "$type": "dimension" },
      "2xl":{ "$value": "1536px", "$type": "dimension" }
    }
  },

  "semantic": {
    "color": {
      "text": {
        "primary":   { "$value": "{primitive.color.gray.900}", "$type": "color" },
        "secondary": { "$value": "{primitive.color.gray.600}", "$type": "color" },
        "tertiary":  { "$value": "{primitive.color.gray.500}", "$type": "color" },
        "disabled":  { "$value": "{primitive.color.gray.400}", "$type": "color" },
        "inverse":   { "$value": "{primitive.color.white}",    "$type": "color" },
        "on-action": { "$value": "{primitive.color.white}",    "$type": "color" },
        "link":      { "$value": "{primitive.color.blue.600}", "$type": "color" }
      },
      "surface": {
        "default":  { "$value": "{primitive.color.white}",    "$type": "color" },
        "raised":   { "$value": "{primitive.color.white}",    "$type": "color" },
        "overlay":  { "$value": "{primitive.color.white}",    "$type": "color" },
        "sunken":   { "$value": "{primitive.color.gray.50}",  "$type": "color" },
        "subtle":   { "$value": "{primitive.color.gray.100}", "$type": "color" }
      },
      "border": {
        "subtle":   { "$value": "{primitive.color.gray.200}", "$type": "color" },
        "default":  { "$value": "{primitive.color.gray.300}", "$type": "color" },
        "strong":   { "$value": "{primitive.color.gray.500}", "$type": "color" },
        "focus":    { "$value": "{primitive.color.blue.500}", "$type": "color" }
      },
      "action": {
        "primary":         { "$value": "{primitive.color.blue.500}", "$type": "color" },
        "primary-hover":   { "$value": "{primitive.color.blue.600}", "$type": "color" },
        "primary-active":  { "$value": "{primitive.color.blue.700}", "$type": "color" },
        "destructive":     { "$value": "{primitive.color.red.500}",  "$type": "color" },
        "destructive-hover":{"$value": "{primitive.color.red.700}",  "$type": "color" }
      },
      "feedback": {
        "success":    { "$value": "{primitive.color.green.500}", "$type": "color" },
        "success-bg": { "$value": "{primitive.color.green.50}",  "$type": "color" },
        "warning":    { "$value": "{primitive.color.amber.500}", "$type": "color" },
        "warning-bg": { "$value": "{primitive.color.amber.50}",  "$type": "color" },
        "danger":     { "$value": "{primitive.color.red.500}",   "$type": "color" },
        "danger-bg":  { "$value": "{primitive.color.red.50}",    "$type": "color" },
        "info":       { "$value": "{primitive.color.blue.500}",  "$type": "color" },
        "info-bg":    { "$value": "{primitive.color.blue.50}",   "$type": "color" }
      }
    },
    "typography": {
      "body": {
        "size":       { "$value": "{primitive.font.size.400}", "$type": "dimension" },
        "lineHeight": { "$value": "{primitive.font.lineHeight.normal}", "$type": "number" },
        "weight":     { "$value": "{primitive.font.weight.regular}", "$type": "fontWeight" }
      },
      "heading-1": {
        "size":       { "$value": "{primitive.font.size.900}", "$type": "dimension" },
        "lineHeight": { "$value": "{primitive.font.lineHeight.tight}", "$type": "number" },
        "weight":     { "$value": "{primitive.font.weight.bold}", "$type": "fontWeight" }
      }
    }
  },

  "component": {
    "button": {
      "primary": {
        "bg":        { "$value": "{semantic.color.action.primary}", "$type": "color" },
        "bg-hover":  { "$value": "{semantic.color.action.primary-hover}", "$type": "color" },
        "text":      { "$value": "{semantic.color.text.on-action}", "$type": "color" },
        "radius":    { "$value": "{primitive.radius.md}", "$type": "dimension" },
        "paddingX":  { "$value": "{primitive.space.5}", "$type": "dimension" },
        "paddingY":  { "$value": "{primitive.space.3}", "$type": "dimension" },
        "gap":       { "$value": "{primitive.space.3}", "$type": "dimension" }
      }
    },
    "card": {
      "bg":      { "$value": "{semantic.color.surface.raised}", "$type": "color" },
      "border":  { "$value": "{semantic.color.border.subtle}", "$type": "color" },
      "radius":  { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding": { "$value": "{primitive.space.7}", "$type": "dimension" },
      "shadow":  { "$value": "{primitive.elevation.2}", "$type": "shadow" }
    },
    "input": {
      "bg":         { "$value": "{semantic.color.surface.default}", "$type": "color" },
      "border":     { "$value": "{semantic.color.border.default}", "$type": "color" },
      "border-focus":{"$value": "{semantic.color.border.focus}", "$type": "color" },
      "text":       { "$value": "{semantic.color.text.primary}", "$type": "color" },
      "placeholder":{ "$value": "{semantic.color.text.tertiary}", "$type": "color" },
      "radius":     { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "paddingX":   { "$value": "{primitive.space.4}", "$type": "dimension" },
      "paddingY":   { "$value": "{primitive.space.3}", "$type": "dimension" }
    }
  }
}
